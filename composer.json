{
    "name": "cboxdk/laravel-relay-client",
    "description": "Cbox Relay client for Laravel: authenticate against Cbox Relay, manage scopes and read the delivery log, with an in-memory fake for tests.",
    "keywords": [
        "cbox",
        "relay",
        "laravel",
        "webhooks",
        "delivery",
        "client"
    ],
    "homepage": "https://github.com/cboxdk/laravel-relay-client",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/cboxdk/laravel-relay-client/issues",
        "source": "https://github.com/cboxdk/laravel-relay-client"
    },
    "authors": [
        {
            "name": "Sylvester Damgaard",
            "email": "sn@cbox.dk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "Cbox\\Relay\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cbox\\Relay\\Client\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cbox\\Relay\\Client\\RelayServiceProvider"
            ],
            "aliases": {
                "Relay": "Cbox\\Relay\\Client\\Facades\\Relay"
            }
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint --test",
        "fix": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress --memory-limit=1G",
        "test": "vendor/bin/pest",
        "license-check": "@php bin/check-licenses.php",
        "sbom": "@php bin/generate-sbom.php",
        "sbom-check": [
            "@sbom",
            "git diff --exit-code sbom.json"
        ],
        "qa": [
            "@lint",
            "@analyse",
            "@test",
            "@license-check",
            "@composer audit --no-dev",
            "@sbom-check"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
